# PR Content Review Agent configuration
#
# Copy this file to `.env` for local development. `.env` is ignored by Git.
# Never put credentials in frontend files, source code, logs, or trace metadata.

# Application — safe local defaults; no secret required.
NODE_ENV=development
PR_REVIEW_API_PORT=3001
PR_REVIEW_MAX_REVISION_COUNT=3

# Full-stack console server (SPRINT-005) — safe defaults, no secret required.
# dev-header is a development identity provider, NOT a production security model.
PR_REVIEW_SERVER_HOST=127.0.0.1
PR_REVIEW_UPLOAD_DIR=data/uploads
PR_REVIEW_AUTH_MODE=dev-header
PR_REVIEW_DEMO_SEED=true

# LLM — `mock` requires no key and is the default for tests/keyless development.
# DeepSeek example: LLM_PROVIDER=deepseek, LLM_MODEL=deepseek-v4-flash.
# Qwen requires a model ID available in your region and your region/workspace's
# OpenAI-compatible URL. Never copy a Base URL from another region blindly.
# For a real provider, set exactly the matching key and explicitly choose a model.
LLM_PROVIDER=mock
LLM_MODEL=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# Retained future providers; PR Review does not require either for DeepSeek/Qwen.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith — optional. Development works without tracing or a key.
# Content tracing stays off unless explicitly enabled after privacy review.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-content-review-agent
TRACE_CONTENT_ENABLED=false

# Retrieval — local requires no external service. Firecrawl is optional/future
# URL ingestion support and is not required for local PR review.
RETRIEVAL_PROVIDER=local
FIRECRAWL_API_KEY=

# Visual review — disabled and mocked until the multimodal milestone.
VISUAL_REVIEW_ENABLED=false
VISUAL_PROVIDER=mock

# Publisher — mandatory safe defaults. INFRA-001 has no real adapter.
PUBLISHER_MODE=mock
REAL_PUBLISHING_ENABLED=false

# Evaluation — mock provider is supported; dataset contents are managed separately.
EVAL_DATASET_PATH=evals/pr-review/data

# Legacy social-media-agent only (not required by PR Review):
# ARCADE_API_KEY, TWITTER_*, LINKEDIN_*, SLACK_*, SUPABASE_*, GITHUB_TOKEN,
# GOOGLE_VERTEX_AI_WEB_CREDENTIALS, REDDIT_*, LANGGRAPH_API_URL.
